{
  "name": "gre-issue",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler pages dev dist --port 8788",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "kb": "uv run --with pypdf python tools/build_kb.py",
    "deploy": "vite build && wrangler pages deploy dist --project-name gre-issue --branch main",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.7",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.7",
    "@astryxdesign/theme-neutral": "^0.7.7",
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
